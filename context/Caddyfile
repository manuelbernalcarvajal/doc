{$MY_DOMAIN:localhost} {
    # Proxy inverso hacia PocketBase
    reverse_proxy 127.0.0.1:8090 {
        # Streaming continuo sin buffer: indispensable para eventos SSE en tiempo real
        flush_interval -1
    }

    # Desactiva el buffering de subida para archivos pesados (hasta 10 GB sin consumir RAM)
    request_body {
        max_size 10GB
    }

    # Compresión ligera
    encode zstd gzip

    # Cabeceras de endurecimiento y seguridad
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
