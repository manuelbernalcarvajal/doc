# === CREDENCIALES ESTRUCTURALES EXTERNAS (S3 REAL) ===
EXTERNAL_S3_PROVIDER=Other
EXTERNAL_S3_ENDPOINT=https://tu-cuenta.r2.cloudflarestorage.com
EXTERNAL_S3_ACCESS_KEY_ID=tu_access_key_externo
EXTERNAL_S3_SECRET_ACCESS_KEY=tu_secret_key_externo
EXTERNAL_S3_BUCKET=mi-despacho-backups
EXTERNAL_S3_REGION=auto

# === CIFRADO ZERO-KNOWLEDGE (RCLONE CRYPT) ===
# Genera contraseñas largas con: openssl rand -base64 32
CRYPT_PASSWORD=clave_maestra_para_cifrar_contenido
CRYPT_PASSWORD2=sal_para_cifrar_nombres_de_archivo

# === DOMINIO ===
MY_DOMAIN=despacho.local
